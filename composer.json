{
    "name": "laravel-tipi/translations",
    "description": "Translatable Eloquent attributes for Laravel, stored in JSON columns, dedicated translation tables or one shared polymorphic table, with context-aware fallback.",
    "keywords": [
        "laravel",
        "localization",
        "translations",
        "eloquent",
        "i18n"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Irakli",
            "email": "iraklikevkhishvili@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "laravel-tipi/localization": "^0.2",
        "laravel-tipi/support": "^1.0.12",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "ext-pcntl": "*",
        "ext-posix": "*",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Tipi\\Translations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tipi\\Translations\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tipi\\Translations\\TranslationsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "test:mysql": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv TRANSLATIONS_TEST_DB=mysql",
            "@putenv TRANSLATIONS_TEST_DB_HOST=127.0.0.1",
            "@putenv TRANSLATIONS_TEST_DB_PORT=33061",
            "@putenv TRANSLATIONS_TEST_DB_PASSWORD=secret",
            "pest"
        ],
        "test:mariadb": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv TRANSLATIONS_TEST_DB=mariadb",
            "@putenv TRANSLATIONS_TEST_DB_HOST=127.0.0.1",
            "@putenv TRANSLATIONS_TEST_DB_PORT=33062",
            "@putenv TRANSLATIONS_TEST_DB_PASSWORD=secret",
            "pest"
        ],
        "test:pgsql": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv TRANSLATIONS_TEST_DB=pgsql",
            "@putenv TRANSLATIONS_TEST_DB_HOST=127.0.0.1",
            "@putenv TRANSLATIONS_TEST_DB_PORT=33063",
            "@putenv TRANSLATIONS_TEST_DB_PASSWORD=secret",
            "pest"
        ],
        "test:all": [
            "@test",
            "@test:mysql",
            "@test:mariadb",
            "@test:pgsql"
        ],
        "format": "pint",
        "format:test": "pint --test",
        "check": [
            "@format:test",
            "@test"
        ],
        "check:all": [
            "@format:test",
            "@test:all"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the test suite on in-memory SQLite.",
        "test:mysql": "Run the test suite on the MySQL service of compose.yaml.",
        "test:mariadb": "Run the test suite on the MariaDB service of compose.yaml.",
        "test:pgsql": "Run the test suite on the PostgreSQL service of compose.yaml.",
        "test:all": "Run the test suite on SQLite, MySQL, MariaDB and PostgreSQL.",
        "check": "Check formatting and run the test suite on SQLite.",
        "check:all": "Check formatting and run the test suite on all four databases."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "support": {
        "issues": "https://github.com/laravel-tipi/translations/issues",
        "source": "https://github.com/laravel-tipi/translations"
    }
}
