{
    "name": "tipi/laravel-translations",
    "description": "Flexible package for Model translations",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Irakli",
            "email": "iraklikevkhishvili@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Tipi\\Translations\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tipi\\Translations\\TranslationServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
