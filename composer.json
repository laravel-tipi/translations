{
    "name": "laravel-tipi/translations",
    "description": "Translatable Eloquent attributes for Laravel, stored in JSON columns or dedicated translation tables, with context-aware fallback.",
    "keywords": [
        "laravel",
        "localization",
        "translations",
        "eloquent",
        "i18n"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Irakli",
            "email": "iraklikevkhishvili@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "laravel-tipi/localization": "^0.2",
        "laravel-tipi/support": "^1.0.12",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Tipi\\Translations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tipi\\Translations\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tipi\\Translations\\TranslationsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "format:test": "pint --test",
        "check": [
            "@format:test",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "support": {
        "issues": "https://github.com/laravel-tipi/translations/issues",
        "source": "https://github.com/laravel-tipi/translations"
    }
}
